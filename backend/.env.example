# Copy these variable names into your local .env and replace every placeholder.
PORT=5000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campusflow?schema=public"
JWT_SECRET="replace-with-at-least-32-random-bytes"
DEFAULT_ORGANIZATION_ID="existing-organization-id"
PLATFORM_ADMIN_SECRET="replace-with-a-different-32-byte-platform-secret"
